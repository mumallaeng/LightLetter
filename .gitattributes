# Exclude Jupyter notebooks from GitHub's repo-level "Languages" stats bar,
# without marking them as generated/vendored -- that would also disable
# GitHub's rich notebook renderer (cells/markdown/outputs) when browsing the
# file, which we still want.
*.ipynb linguist-detectable=false
*.html linguist-detectable=false

# Git on Windows (core.autocrlf=true) would check bash and Tcl scripts out as CRLF, which breaks them; cmd files need CRLF
*.sh text eol=lf
*.tcl text eol=lf
*.cmd text eol=crlf
