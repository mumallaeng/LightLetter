# *.srcs may contain authored Block Design/IP configuration sources.
# Do not ignore the whole directory; review and track required BD/XCI files.
# Regenerated Vitis BSP and temporary launch scripts
**/vitis/**/bsp/
**/vitis/**/Release/
**/vitis/temp_xsdb_launch_script.tcl
legacy/vitis/BFSK_TX_Test_system/_ide/scripts/systemdebugger_*.tcl
# Retain authored BFSK Vivado project and Vitis recreation files
!legacy/tb_xpr/**/*.xpr
!legacy/tb_xpr/**/*.srcs/
!legacy/vitis/BFSK_Tx/platform.tcl
!legacy/vitis/BFSK_Tx/platform.spr
!legacy/vitis/BFSK_TX_Test/_ide/

# macOS debug symbols from local builds
**/*.dSYM/

