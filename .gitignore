vitis/**/bsp/
vitis/**/Release/
vitis/temp_xsdb_launch_script.tcl
vitis/BFSK_TX_Test_system/_ide/scripts/systemdebugger_*.tcl


# Retain authored BFSK Vivado project and Vitis recreation files
!tb_xpr/**/*.xpr
!tb_xpr/**/*.srcs/
!vitis/BFSK_Tx/platform.tcl
